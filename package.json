{
  "name": "baccarat-strategy-sandbox",
  "version": "0.1.0",
  "description": "Offline baccarat simulator and strategy lab for studying Martingale risk.",
  "author": "Baccarat Strategy Sandbox contributors",
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "desktop:mac": "npm run build && electron-builder --mac --publish never",
    "desktop:win": "npm run build && electron-builder --win --publish never",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run"
  },
  "build": {
    "appId": "io.github.baccarat-strategy-sandbox",
    "productName": "Baccarat Strategy Sandbox",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.6"
  }
}
